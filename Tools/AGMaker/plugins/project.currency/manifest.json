{
  "manifestVersion": 1,
  "id": "project.currency",
  "kind": "game-tool",
  "distribution": "project-private",
  "enabledByDefault": false,
  "name": "货币系统",
  "version": "0.1.0",
  "description": "项目私有货币系统插件：配置货币种类与兑换比例（基准货币锚定 + 定向兑换对覆盖 + 手续费），并提供货币列表/汇率试算静态工具页。声明复用平台已实现的 com.aigame.currency.* 受信 Agent Action，不新增原生 Action。",
  "author": "Project Team",
  "category": "plugin-workshop/gameplay",
  "compatibility": {
    "workbench": ">=0.1.0"
  },
  "capabilities": [
    "toolgen.read",
    "toolgen.write"
  ],
  "dataRoots": [
    "Currency"
  ],
  "homepage": "currency-manager",
  "domainCapabilities": [
    {
      "id": "project.currency",
      "version": "0.1.0",
      "title": "货币系统（配置 + 兑换）",
      "description": "配置货币种类（id/name/precision/unitValueInBase）与兑换体系（基准锚定 + 定向 override + feeRate），并提供汇率试算。复用平台 com.aigame.currency.* 受信 Action 完成读写与校验。",
      "maturity": "experimental",
      "scope": "plugin",
      "risk": "medium",
      "requires": [],
      "contracts": {
        "runtime": [],
        "schema": [
          "knowledge/currency-schema.md"
        ],
        "actions": [
          "com.aigame.currency.list_currencies",
          "com.aigame.currency.get_currency",
          "com.aigame.currency.validate_currency",
          "com.aigame.currency.find_currency_references",
          "com.aigame.currency.create_currency",
          "com.aigame.currency.update_currency",
          "com.aigame.currency.get_exchange_config",
          "com.aigame.currency.set_base_currency",
          "com.aigame.currency.upsert_exchange_override",
          "com.aigame.currency.remove_exchange_override",
          "com.aigame.currency.quote_exchange"
        ],
        "editor": [
          "currency-manager"
        ],
        "skills": [
          "currency-configuration"
        ],
        "knowledge": [
          "knowledge/currency-schema.md",
          "knowledge/currency-design.md"
        ],
        "recipes": [
          "currency-setup"
        ],
        "migrations": []
      },
      "verification": {
        "contractTests": [
          "plugin-manifest.contract"
        ],
        "integrationTests": [
          "plugin-workshop.integration"
        ],
        "runtimeSmokeTests": [],
        "e2eScenarios": [
          "configure-gold-gem-exchange"
        ]
      }
    }
  ],
  "tools": [
    {
      "id": "currency-manager",
      "name": "货币管理",
      "description": "货币种类配置、汇率关系展示与本地兑换试算。数据经 /plugins/project.currency/platform/* 受控代理读写。",
      "icon": "💰",
      "category": "plugin-workshop/gameplay",
      "url": "/plugins/project.currency/",
      "openInUETab": true,
      "schemaVersion": 1,
      "capabilities": [
        "toolgen.read",
        "toolgen.write"
      ],
      "agentActions": [
        {
          "name": "com.aigame.currency.list_currencies",
          "displayName": "列出货币",
          "description": "只读。列出当前项目全部货币摘要（id/name/precision/unitValueInBase）。创建或修改前必须先调用，避免 id 冲突与重复设计。",
          "risk": "safe",
          "parameters": { "type": "object", "properties": {}, "required": [] }
        },
        {
          "name": "com.aigame.currency.get_currency",
          "displayName": "读取货币详情",
          "description": "只读。读取一个已保存货币的完整定义；修改前先确认现状。",
          "risk": "safe",
          "parameters": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "货币 ID，例如 CUR_gold" }
            },
            "required": ["id"]
          }
        },
        {
          "name": "com.aigame.currency.validate_currency",
          "displayName": "校验货币配置",
          "description": "只读。校验货币文档结构约束（id 非空 / precision ∈ [0,8] 整数 / unitValueInBase > 0），不写文件。传 id 校验已保存货币，传 currency 对象校验候选数据。",
          "risk": "safe",
          "parameters": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "可选：已保存货币 ID；与 currency 二选一" },
              "currency": { "type": "object", "description": "可选：待校验的候选货币对象；与 id 二选一" }
            },
            "required": []
          }
        },
        {
          "name": "com.aigame.currency.find_currency_references",
          "displayName": "查找货币引用",
          "description": "只读。查找货币在商店、掉落、任务奖励、兑换对等配置中的引用。删除或改基准前必须调用。",
          "risk": "safe",
          "parameters": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "要查引用的货币 ID" }
            },
            "required": ["id"]
          }
        },
        {
          "name": "com.aigame.currency.create_currency",
          "displayName": "创建货币",
          "description": "受控新增。创建新货币（id/name/description/precision/unitValueInBase），仅新增不覆盖。创建前必须先 list_currencies。",
          "risk": "safe",
          "parameters": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "货币 ID，建议 CUR_ 前缀，例如 CUR_gem" },
              "name": { "type": "string", "description": "显示名，例如「钻石」" },
              "description": { "type": "string", "description": "可选：货币描述" },
              "precision": { "type": "number", "description": "可选：小数位数 [0,8] 整数，缺省 0" },
              "unitValueInBase": { "type": "number", "description": "可选：相对基准货币的单位价值（>0），缺省 1。例：1 钻石=100 金币则填 100" }
            },
            "required": ["id", "name"]
          }
        },
        {
          "name": "com.aigame.currency.update_currency",
          "displayName": "更新货币",
          "description": "写入。增量更新已有货币，未传字段保留，随后执行完整校验。修改前必须先 get_currency。",
          "risk": "critical",
          "parameters": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "要更新的货币 ID" },
              "name": { "type": "string", "description": "可选：新显示名" },
              "description": { "type": "string", "description": "可选：新描述" },
              "precision": { "type": "number", "description": "可选：新小数位数 [0,8] 整数" },
              "unitValueInBase": { "type": "number", "description": "可选：新单位价值（>0）" }
            },
            "required": ["id"]
          }
        },
        {
          "name": "com.aigame.currency.get_exchange_config",
          "displayName": "读取兑换体系配置",
          "description": "只读。读取 Currency/_exchange.json：baseCurrencyId 与 overrides（定向兑换对 + feeRate）。",
          "risk": "safe",
          "parameters": { "type": "object", "properties": {}, "required": [] }
        },
        {
          "name": "com.aigame.currency.set_base_currency",
          "displayName": "设置基准货币",
          "description": "写入。设置兑换体系的基准货币（其 unitValueInBase 必须为 1），作为任意两种货币换算的锚点。",
          "risk": "critical",
          "parameters": {
            "type": "object",
            "properties": {
              "currencyId": { "type": "string", "description": "作为基准的货币 ID，例如 CUR_gold" }
            },
            "required": ["currencyId"]
          }
        },
        {
          "name": "com.aigame.currency.upsert_exchange_override",
          "displayName": "新增/更新定向兑换对",
          "description": "写入。为 from→to 设置定向兑换比率 rate（1 单位 from 兑 rate 单位 to）与可选手续费率 feeRate ∈ [0,1)。覆盖基准锚定换算。",
          "risk": "critical",
          "parameters": {
            "type": "object",
            "properties": {
              "override": {
                "type": "object",
                "description": "定向兑换对 { from, to, rate, feeRate? }",
                "properties": {
                  "from": { "type": "string", "description": "源货币 ID" },
                  "to": { "type": "string", "description": "目标货币 ID" },
                  "rate": { "type": "number", "description": "兑换比率（>0）：1 单位 from 兑 rate 单位 to" },
                  "feeRate": { "type": "number", "description": "可选：手续费率 [0,1)，缺省 0" }
                },
                "required": ["from", "to", "rate"]
              }
            },
            "required": ["override"]
          }
        },
        {
          "name": "com.aigame.currency.remove_exchange_override",
          "displayName": "移除定向兑换对",
          "description": "写入。移除 from→to 的定向兑换对，回退到基准锚定换算。",
          "risk": "critical",
          "parameters": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "description": "源货币 ID" },
              "to": { "type": "string", "description": "目标货币 ID" }
            },
            "required": ["from", "to"]
          }
        },
        {
          "name": "com.aigame.currency.quote_exchange",
          "displayName": "兑换试算",
          "description": "只读纯函数试算，不写盘。override 优先，否则基准锚定换算；net 按目标货币 precision 向下截断（防增发）。返回 gross/fee/net/path/rate。",
          "risk": "safe",
          "parameters": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "description": "源货币 ID" },
              "to": { "type": "string", "description": "目标货币 ID" },
              "amount": { "type": "number", "description": "源货币数量（>0）" }
            },
            "required": ["from", "to", "amount"]
          }
        }
      ]
    }
  ],
  "carries": {
    "skills": [
      "skills/**/*.json"
    ],
    "knowledgeDocs": [
      "knowledge/**/*.md",
      "README.md"
    ],
    "workflowTemplates": [
      "workflows/*.json"
    ],
    "engineeringTypes": [],
    "assetWorkflowTemplates": []
  },
  "dependencies": []
}
